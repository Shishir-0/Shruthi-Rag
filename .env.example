# SHRUTI Production Environment Variables

# Sarvam AI Credentials (for Saaras v3 STT & Bulbul v3 TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# LLM Provider API Keys (Optional - Tier 1 Extractive functions without LLM key)
OPENAI_API_KEY=your_openai_api_key_here

# Infrastructure Connections
QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_HOST=localhost
REDIS_PORT=6379

# Environment
ENVIRONMENT=development
