# SHRUTI Multilingual Voice-First RAG System Environment Variables

# Application Environment (development / production)
ENVIRONMENT=development

# Test Mode Guard: Set to true ONLY for offline test fixture execution without real API keys
SHRUTI_TEST_MODE=false

# CORS Security: Comma-separated list of allowed origins (production must specify exact domain)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# OpenAI Realtime API & Speech-to-Speech Credentials
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-10-01

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_optional

# Caching (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
