# SHRUTI Multilingual Voice-First RAG System Environment Variables

# Application Environment (development / production)
ENVIRONMENT=development

# Test Mode Guard: Set to true ONLY for offline test fixture execution without real API keys
SHRUTI_TEST_MODE=false

# CORS Security: Comma-separated list of allowed origins (production must specify exact domain)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Sarvam AI API Credentials (Saaras v3 STT & Bulbul v3 TTS)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# OpenAI API Credentials (Optional Tier 2 Synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Caching (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
